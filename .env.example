OPENAI_API_KEY=
ELASTIC_API_KEY=
ELASTIC_URL=
ELASTIC_INDEX=signal_chunks
MCP_URL=http://3.143.20.160/mcp
CHAT_MODEL=gpt-4.1
FAST_MODEL=gpt-4.1-mini
EMBED_MODEL=text-embedding-3-small

# Optional integrations (features switch on when set)
SENTRY_DSN=
GPTZERO_API_KEY=

# Deep team analysis: independent verifier on a different model family, via OpenRouter (falls back to OpenAI if unset)
OPENROUTER_API_KEY=
VERIFIER_MODEL=deepseek/deepseek-v4.1-flash

# identification questions: lookup (fast, default) | team | auto
IDENTIFY_FLOW=lookup

# sign-in and saved history (email + password; data stored in MongoDB)
SESSION_SECRET=        # long random string that signs the login cookie
AUTH_REQUIRED=1        # 1 = sign in required, 0 = open like before
COOKIE_SECURE=0        # set 1 when served over https
MONGODB_URI=           # mongodb+srv://user:password@cluster.xxxx.mongodb.net/  (empty = in-memory, lost on restart)
MONGODB_DB=signal
RATE_LIMIT_PER_HOUR=60 # questions per user per hour
ADMIN_USERS=           # optional comma-separated emails that are admins; empty = the first account to register is admin
